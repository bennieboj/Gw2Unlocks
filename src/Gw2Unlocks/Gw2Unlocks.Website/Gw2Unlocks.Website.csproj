<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Scriban" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Gw2Unlocks.Common\Gw2Unlocks.Common.csproj" />
    <ProjectReference Include="..\IconSpriteSheet\Gw2Unlocks.IconSpriteSheet.Cache\Gw2Unlocks.IconSpriteSheet.Cache.csproj" />
    <ProjectReference Include="..\UnlockClassifier\Gw2Unlocks.UnlockClassifier.Cache\Gw2Unlocks.UnlockClassifier.Cache.csproj" />
    <ProjectReference Include="..\UnlockClassifier\Gw2Unlocks.UnlockClassifier\Gw2Unlocks.UnlockClassifier.csproj" />
  </ItemGroup>
  
  <ItemGroup>
    <Folder Include="wwwroot\" />
  </ItemGroup>
  
  <ItemGroup>
    <None Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="CleanCopiedInput" BeforeTargets="BeforeBuild">
    <ItemGroup>
      <FilesToDelete Include="$(OutDir)WebsiteTemplates\*.*" />
    </ItemGroup>
    <Delete Files="@(FilesToDelete)" />
  </Target>
  <ItemGroup>
    <None Include="$(ProjectDir)WebsiteTemplates\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CleanCopiedInput" BeforeTargets="BeforeBuild">
    <ItemGroup>
      <FilesToDelete Include="$(OutDir)WebsiteStaticFiles\*.*" />
    </ItemGroup>
    <Delete Files="@(FilesToDelete)" />
  </Target>
  <ItemGroup>
    <None Include="$(ProjectDir)WebsiteStaticFiles\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  
</Project>
